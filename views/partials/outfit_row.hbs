<div
  class="outfit-row flex items-center justify-between gap-2 py-3"
  data-category="{{row.value}}"
  data-index="{{row.currentIndex}}"
  data-count="{{row.garmentCount}}"
  _="on touchstart
     set my startX to event.touches[0].clientX
     set my startY to event.touches[0].clientY
   on touchmove
     if my startX is not null
       set dx to Math.abs(event.touches[0].clientX - my startX)
       set dy to Math.abs(event.touches[0].clientY - my startY)
       if dx > dy
         js(event) event.preventDefault() end
       end
     end
   on touchend
     if my startX is not null
       set dx to event.changedTouches[0].clientX - my startX
       set my startX to null
       set my startY to null
       if Math.abs(dx) >= 30
         set cnt to (me's @data-count as Int)
         set idx to (me's @data-index as Int)
         if dx < 0
           set newIdx to idx + 1
           if newIdx > cnt then set newIdx to 0 end
         else
           set newIdx to idx - 1
           if newIdx < 0 then set newIdx to cnt end
         end
         js(me, newIdx) htmx.ajax('GET', '/outfits/row-fragment?category=' + encodeURIComponent(me.dataset.category) + '&index=' + newIdx, {target: me, swap: 'outerHTML'}) end
       end
     end"
>
  <div class="flex min-w-0 items-center gap-2">
    <button
      type="button"
      class="drag-handle btn btn-ghost btn-square btn-sm shrink-0 cursor-grab active:cursor-grabbing touch-none"
      title="{{t 'lang.DRAG_TO_REORDER'}}"
      aria-label="{{t 'lang.DRAG_TO_REORDER'}}"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.7"
        stroke="currentColor"
        class="size-4"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.75 5.25h.008v.008H9.75V5.25Zm0 4.5h.008v.008H9.75v-.008Zm0 4.5h.008v.008H9.75v-.008Zm0 4.5h.008v.008H9.75v-.008Zm4.5-13.5h.008v.008h-.008V5.25Zm0 4.5h.008v.008h-.008v-.008Zm0 4.5h.008v.008h-.008v-.008Zm0 4.5h.008v.008h-.008v-.008Z"
        />
      </svg>
    </button>
    <span class="w-20 shrink-0 text-sm font-semibold capitalize"
      >{{row.label}}</span
    >
    <button
      type="button"
      class="btn btn-ghost btn-circle btn-sm shrink-0"
      aria-label="Previous {{row.label}}"
      hx-get="/outfits/row-fragment?category={{uri row.value}}&index={{row.prevIndex}}"
      hx-target="closest .outfit-row"
      hx-swap="outerHTML"
    >
      &#8249;
    </button>
    {{#if row.currentGarment}}
    <button
      type="button"
      class="group flex shrink-0 items-center rounded-field px-1 py-1 text-left transition-colors duration-150 hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none"
      aria-label="Choose {{row.label}}"
      onclick="window.openOutfitGarmentPicker(this)"
    >
      {{#if row.currentGarment.photo}}<img
        class="size-12 shrink-0 rounded-field object-contain"
        src="{{row.currentGarment.photo}}"
        alt=""
      />{{else}}<span
        class="flex size-12 shrink-0 items-center justify-center rounded-field bg-base-200 text-base-content/35"
        >—</span
      >{{/if}}
    </button>
    {{else}}
    <button
      type="button"
      class="flex min-w-0 flex-1 items-center gap-2 rounded-field px-1 py-1 text-left text-sm text-base-content/50 transition-colors duration-150 hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none"
      onclick="window.openOutfitGarmentPicker(this)"
    >
      <span
        class="flex size-12 shrink-0 items-center justify-center rounded-field bg-base-200"
        >—</span
      ><span>Choose a {{row.label}}</span>
    </button>
    {{/if}}
    <button
      type="button"
      class="btn btn-ghost btn-circle btn-sm shrink-0"
      aria-label="Next {{row.label}}"
      hx-get="/outfits/row-fragment?category={{uri row.value}}&index={{row.nextIndex}}"
      hx-target="closest .outfit-row"
      hx-swap="outerHTML"
    >
      &#8250;
    </button>
  </div>
  <button
    type="button"
    class="btn btn-ghost btn-circle btn-sm shrink-0 text-error hover:bg-error/10 hover:text-error"
    aria-label="Remove {{row.label}}"
    _="on click remove closest .outfit-row"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.8"
      stroke="currentColor"
      class="size-4"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m6 18 12-12M6 6l12 12"
      />
    </svg>
  </button>
  <input type="hidden" name="category" value="{{row.value}}" />
  <input
    type="hidden"
    name="garmentId"
    value="{{#if row.garmentId}}{{row.garmentId}}{{/if}}"
  />
</div>
