<div class="drawer navbar">
  <input id="closet-nav-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <header class="navbar h-16 border-b border-base-content/10 bg-base-100 shadow-sm">
      <div class="navbar-start gap-2">
        <label for="closet-nav-drawer" aria-label="Open navigation" class="btn btn-square btn-ghost lg:hidden">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="size-6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4.5 6.75h15m-15 5.25h15M4.5 17.25h15" /></svg>
        </label>
        <div class="flex items-center gap-3">
          <span class="grid size-9 place-items-center rounded-box bg-primary text-primary-content shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4.12572 15.3668 10.1284 11.9903C10.7234 11.6556 11.3252 11.5 12 11.5c.6748 0 1.2766.1556 1.8716.4903l6.0027 3.3765C20.5697 15.7579 21 16.4937 21 17.2916 21 18.5113 20.0113 19.5 18.7916 19.5H5.2084C3.9887 19.5 3 18.5113 3 17.2916c0-.7979.4303-1.5337 1.1257-1.9248Z" /><path stroke-linecap="round" stroke-width="1.7" d="M10 6.4C10 5.35 10.9 4.5 12 4.5s2 .85 2 1.9c0 .72-.42 1.35-1.04 1.67-.49.26-.96.68-.96 1.24v2.19" /></svg></span>
          <span><span class="block text-sm font-semibold leading-none">{{appName}}</span><span class="mt-1 block text-[0.65rem] font-medium uppercase tracking-[0.18em] text-base-content/45">Private wardrobe</span></span>
        </div>
      </div>
      <div class="navbar-end">
        {{#if authEnabled}}{{#if user}}
        <a href="/auth/profile" class="btn btn-ghost gap-2 px-2 sm:px-3 {{#ifEquals baseUrl "/auth/profile"}}btn-active{{/ifEquals}}" aria-label="{{t 'lang.PROFILE'}}">
          <span class="avatar avatar-placeholder"><span class="grid size-8 place-items-center rounded-full bg-base-300 text-base-content"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.12a7.5 7.5 0 0 1 15 0" /></svg></span></span>
          <span class="hidden max-w-40 truncate text-sm sm:block">{{user.email}}</span>
        </a>
        {{else}}
          {{#unless signupsDisabled}}<a href="/auth/register" class="btn btn-ghost btn-sm hidden sm:inline-flex">{{t 'lang.REGISTER'}}</a>{{/unless}}
          <a href="/auth/login" class="btn btn-sm">{{t 'lang.LOGIN'}}</a>
        {{/if}}{{/if}}
      </div>
    </header>
  </div>
  <aside class="drawer-side">
    <label for="closet-nav-drawer" aria-label="Close navigation" class="drawer-overlay"></label>
    <div class="flex min-h-full w-80 flex-col border-r border-base-content/10 bg-base-100 p-4 pt-6">
      <a href="/" class="mb-7 flex items-center gap-3 px-2"><span class="grid size-10 place-items-center rounded-box bg-primary text-primary-content"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4.12572 15.3668 10.1284 11.9903C10.7234 11.6556 11.3252 11.5 12 11.5c.6748 0 1.2766.1556 1.8716.4903l6.0027 3.3765C20.5697 15.7579 21 16.4937 21 17.2916 21 18.5113 20.0113 19.5 18.7916 19.5H5.2084C3.9887 19.5 3 18.5113 3 17.2916c0-.7979.4303-1.5337 1.1257-1.9248Z" /></svg></span><span><span class="block font-semibold">{{appName}}</span><span class="block text-xs text-base-content/50">Private wardrobe</span></span></a>
      {{#if authEnabled}}{{#if user}}
      <p class="menu-title px-3">Your closet</p>
      <ul class="menu menu-md gap-1">
        <li><a href="/wardrobe" class="{{#ifEquals baseUrl "/wardrobe"}}menu-active{{/ifEquals}}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4.12572 15.3668 10.1284 11.9903C10.7234 11.6556 11.3252 11.5 12 11.5c.6748 0 1.2766.1556 1.8716.4903l6.0027 3.3765C20.5697 15.7579 21 16.4937 21 17.2916 21 18.5113 20.0113 19.5 18.7916 19.5H5.2084C3.9887 19.5 3 18.5113 3 17.2916c0-.7979.4303-1.5337 1.1257-1.9248Z" /></svg>{{t 'lang.WARDROBE'}}</a></li>
        <li><a href="/outfits" class="{{#ifEquals baseUrl "/outfits"}}menu-active{{/ifEquals}}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M6.75 4.5h9A2.25 2.25 0 0 1 18 6.75v9A2.25 2.25 0 0 1 15.75 18h-9a2.25 2.25 0 0 1-2.25-2.25v-9A2.25 2.25 0 0 1 6.75 4.5Z" /><path stroke-linecap="round" stroke-width="1.7" d="M8.25 9.75h7.5m-7.5 4.5h4.5" /></svg>{{t 'lang.OUTFITS'}}</a></li>
        <li><a href="/calendar" class="{{#ifEquals baseUrl "/calendar"}}menu-active{{/ifEquals}}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75" /></svg>{{t 'lang.CALENDAR'}}</a></li>
      </ul>
      <p class="menu-title mt-6 px-3">Account</p>
      <ul class="menu menu-md gap-1">
        <li><a href="/auth/profile" class="{{#ifEquals baseUrl "/auth/profile"}}menu-active{{/ifEquals}}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.12a7.5 7.5 0 0 1 15 0" /></svg>{{t 'lang.PROFILE'}}</a></li>
        <li><a href="/auth/mcp"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 6.75a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M19.5 12a7.5 7.5 0 0 1-10.77 6.75M4.5 12A7.5 7.5 0 0 1 15.27 5.25" /></svg>Connect your AI</a></li>
      </ul>
      <div class="mt-auto rounded-box bg-base-200 p-3"><p class="truncate text-sm font-medium">{{user.email}}</p><form method="post" action="/auth/logout" class="mt-2"><button class="btn btn-ghost btn-sm w-full justify-start" type="submit">{{t 'lang.LOGOUT'}}</button></form></div>
      {{else}}
      <ul class="menu menu-md gap-1"><li><a href="/auth/login">{{t 'lang.LOGIN'}}</a></li>{{#unless signupsDisabled}}<li><a href="/auth/register">{{t 'lang.REGISTER'}}</a></li>{{/unless}}</ul>
      {{/if}}{{/if}}
    </div>
  </aside>
</div>
