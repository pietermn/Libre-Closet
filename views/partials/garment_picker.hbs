<div class="p-5">
  <div class="mb-4 flex items-start justify-between gap-3">
    <div>
      <p class="text-xs font-semibold tracking-wider text-primary uppercase">
        {{categoryLabel}}
      </p>
      <h2 class="mt-1 text-xl font-bold tracking-tight">Choose a garment</h2>
    </div>
    <form method="dialog">
      <button class="btn btn-ghost btn-circle btn-sm" aria-label="Close">
        ✕
      </button>
    </form>
  </div>
  <input
    id="outfit-garment-search"
    type="search"
    class="input w-full"
    placeholder="Search {{categoryLabel}}…"
    oninput="window.filterOutfitGarmentPicker(this)"
  />
  <div
    class="mt-4 grid max-h-[60vh] grid-cols-2 gap-2 overflow-y-auto pr-1 sm:grid-cols-3"
  >
    {{#each garments}}
    <button
      type="button"
      data-picker-item
      data-search="{{this.name}} {{this.brand}}"
      class="group relative min-w-0 rounded-box border border-base-content/8 bg-base-200 p-2 text-left transition-[transform,background-color,box-shadow] duration-150 hover:-translate-y-0.5 hover:bg-base-100 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none"
      onclick="window.selectOutfitGarment('{{../category}}', {{this.id}})"
    >
      {{#if this.selected}}<span
        class="absolute right-2 top-2 badge badge-primary badge-sm"
        >Current</span
      >{{/if}}
      <span class="flex aspect-square items-center justify-center"
        >{{#if this.photo}}<img
          src="{{this.photo}}"
          alt=""
          class="h-full w-full object-contain"
        />{{else}}<span class="text-xs text-base-content/30">No photo</span
        >{{/if}}</span
      >
      <span class="mt-2 block truncate text-sm font-semibold"
        >{{this.name}}</span
      >{{#if this.brand}}<span
        class="mt-0.5 block truncate text-xs text-base-content/55"
        >{{this.brand}}</span
      >{{/if}}
    </button>
    {{/each}}
  </div>
</div>
