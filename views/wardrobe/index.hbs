{{>navbar}}

<main class="mx-auto max-w-6xl px-4 pb-28 pt-4 sm:px-6">
  <section class="mb-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="mb-1 text-xs font-semibold tracking-wider text-primary uppercase">{{garments.length}} {{t 'lang.RESULTS'}}</p>
        <h1 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">{{t 'lang.WARDROBE'}}</h1>
      </div>
      {{#if canEdit}}
      <a href="/wardrobe/new{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-primary btn-sm shrink-0 gap-2 shadow-sm transition-transform duration-150 ease-out active:scale-[0.97] motion-reduce:transition-none">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4" aria-hidden="true">
          <path stroke-linecap="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span class="hidden sm:inline">{{t 'lang.NEW_GARMENT'}}</span>
        <span class="sm:hidden">Add</span>
      </a>
      {{/if}}
    </div>

    {{!-- Shared wardrobe switcher --}}
    {{#if sharedWardrobes.length}}
    <label class="mt-5 flex max-w-sm items-center gap-3 text-sm text-base-content/60">
      <span class="shrink-0">{{t 'lang.MY_WARDROBE'}}</span>
      <select class="select select-ghost select-sm min-w-0 flex-1 font-medium text-base-content" onchange="location.href=this.value" aria-label="Select wardrobe">
        <option value="/wardrobe" {{#unless viewOwner}}selected{{/unless}}>{{t 'lang.MY_WARDROBE'}}</option>
        {{#each sharedWardrobes}}
        <option value="/wardrobe?ownerId={{this.grantorId}}" {{#ifEquals ../viewOwner this.grantorId}}selected{{/ifEquals}}>{{this.grantorName}} ({{this.permission}})</option>
        {{/each}}
      </select>
    </label>
    {{/if}}

    <div class="mt-6 rounded-box border border-base-content/10 bg-base-200/60 p-2 shadow-sm">
      <form method="get" action="/wardrobe" id="search-form" class="flex items-center gap-2">
        <input type="hidden" name="category" id="active-category" value="{{search.category}}">
        <input type="hidden" name="color" id="active-color" value="{{search.color}}">
        <input type="hidden" name="size" id="active-size" value="{{search.size}}">
        <input type="hidden" name="archived" id="active-archived" value="{{search.archived}}">
        {{#if viewOwner}}<input type="hidden" name="ownerId" value="{{viewOwner}}">{{/if}}
        <label class="input input-sm flex min-w-0 flex-1 items-center gap-2 border-0 bg-base-100 shadow-none focus-within:outline-primary">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4 shrink-0 text-base-content/45" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m2.1-5.4a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" />
          </svg>
          <input type="text" name="keyword" value="{{search.keyword}}" placeholder="{{t 'lang.SEARCH_PLACEHOLDER'}}" class="min-w-0 grow" />
        </label>
        <button type="button" _="on click call #filter-modal.showModal()" class="btn btn-ghost btn-sm btn-square shrink-0" aria-label="{{t 'lang.FILTER_SEARCH'}}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
          </svg>
        </button>
        <button type="submit" class="btn btn-primary btn-sm btn-square shrink-0" aria-label="{{t 'lang.SEARCH'}}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </button>
      </form>

      {{#if search.category}}
      <div class="flex flex-wrap gap-1.5 px-1 pt-2">
        <a href="/wardrobe?keyword={{search.keyword}}&color={{search.color}}&size={{search.size}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}" class="badge badge-soft badge-primary badge-sm gap-1 no-underline capitalize">{{search.category}} <span aria-hidden="true">&times;</span><span class="sr-only">Remove category filter</span></a>
      {{else}}
      <div class="flex flex-wrap gap-1.5 px-1 pt-2 {{#unless search.color}}{{#unless search.size}}{{#unless search.archived}}hidden{{/unless}}{{/unless}}{{/unless}}">
      {{/if}}
        {{#if search.color}}
        <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&size={{search.size}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}" class="badge badge-soft badge-secondary badge-sm gap-1 no-underline capitalize">{{search.color}} <span aria-hidden="true">&times;</span><span class="sr-only">Remove color filter</span></a>
        {{/if}}
        {{#if search.size}}
        <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&color={{search.color}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}" class="badge badge-soft badge-accent badge-sm gap-1 no-underline">{{search.size}} <span aria-hidden="true">&times;</span><span class="sr-only">Remove size filter</span></a>
        {{/if}}
        {{#if search.archived}}
        <a href="/wardrobe?keyword={{search.keyword}}&category={{search.category}}&color={{search.color}}&size={{search.size}}{{#if viewOwner}}&ownerId={{viewOwner}}{{/if}}" class="badge badge-soft badge-warning badge-sm gap-1 no-underline">{{t 'lang.ARCHIVED'}} <span aria-hidden="true">&times;</span><span class="sr-only">Remove archived filter</span></a>
        {{/if}}
      </div>
    </div>
  </section>

  {{#if garments.length}}
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4 xl:grid-cols-5">
    {{#each garments}}
    <a href="/wardrobe/{{this.id}}{{#if ../viewOwner}}?ownerId={{../viewOwner}}{{/if}}" class="card group overflow-hidden border border-base-content/8 bg-base-100 shadow-sm transition-[transform,box-shadow] duration-150 ease-out hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none {{#if this.archived}}opacity-50{{/if}}">
      <figure class="aspect-[4/5] overflow-hidden bg-base-200">
        {{#if this.photo}}
        <img src="/file/nobg/{{this.photo.fileName}}" alt="{{this.name}}" class="h-full w-full object-contain p-3 transition-transform duration-200 ease-out group-hover:scale-[1.02] motion-reduce:transition-none" />
        {{else}}
        <div class="flex items-center justify-center w-full h-full text-base-content/30">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-12">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.251 2.251 0 0 1 2.012 1.244l.256.512a2.251 2.251 0 0 0 2.013 1.244h3.218a2.251 2.251 0 0 0 2.013-1.244l.256-.512a2.251 2.251 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3" />
          </svg>
        </div>
        {{/if}}
      </figure>
      <div class="card-body gap-1 p-3">
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-medium text-base-content/55 capitalize">{{this.category}}</p>
          {{#if this.archived}}<span class="badge badge-ghost badge-xs">{{t 'lang.ARCHIVED'}}</span>{{/if}}
        </div>
        <h2 class="card-title min-h-10 text-sm leading-5">{{this.name}}</h2>
      </div>
    </a>
    {{/each}}
  </div>
  {{else}}
  <div class="card border border-dashed border-base-content/15 bg-base-200/35">
    <div class="card-body items-center py-16 text-center text-base-content/50">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-16">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.251 2.251 0 0 1 2.012 1.244l.256.512a2.251 2.251 0 0 0 2.013 1.244h3.218a2.251 2.251 0 0 0 2.013-1.244l.256-.512a2.251 2.251 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3" />
    </svg>
    <p class="max-w-sm text-sm">{{t 'lang.NO_GARMENTS'}}</p>
    {{#if canEdit}}
    <a href="/wardrobe/new{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-primary btn-sm">{{t 'lang.ADD_FIRST_GARMENT'}}</a>
    {{/if}}
    </div>
  </div>
  {{/if}}
</main>

{{!-- Filter modal --}}
<dialog id="filter-modal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box">
    <h3 class="font-bold text-lg mb-4">{{t 'lang.FILTERS'}}</h3>

    {{!-- Garment Type --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.GARMENT_TYPE'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each availableCategories}}
        <label class="cursor-pointer">
          <input type="radio" name="modal-category" value="{{this.value}}" class="hidden peer"
            {{#ifEquals this.value ../search.category}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-primary capitalize select-none">{{this.label}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{!-- Color --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.COLOR'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each colors}}
        <label class="cursor-pointer">
          <input type="radio" name="modal-color" value="{{this}}" class="hidden peer"
            {{#ifEquals this ../search.color}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-secondary capitalize select-none">{{this}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{!-- Size --}}
    {{#if availableSizes.length}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.SIZE'}}</h4>
      <div class="flex flex-wrap gap-2">
        {{#each availableSizes}}
        <label class="cursor-pointer">
          <input type="radio" name="modal-size" value="{{this}}" class="hidden peer"
            {{#ifEquals this ../search.size}}checked{{/ifEquals}}>
          <span class="badge badge-outline peer-checked:badge-accent select-none">{{this}}</span>
        </label>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{!-- Archived --}}
    <div class="mb-5">
      <h4 class="font-medium text-sm text-base-content/60 uppercase tracking-wide mb-2">{{t 'lang.ARCHIVED'}}</h4>
      <label class="cursor-pointer flex items-center gap-2">
        <input type="checkbox" name="modal-archived" value="true" class="checkbox checkbox-sm"
          {{#if search.archived}}checked{{/if}}>
        <span class="text-sm">{{t 'lang.SHOW_ARCHIVED'}}</span>
      </label>
    </div>

    <div class="modal-action">
      <button type="button"
        class="btn btn-ghost btn-sm"
        _="on click
          for el in <input[name='modal-category']/>
            set el.checked to false
          end
          for el in <input[name='modal-color']/>
            set el.checked to false
          end
          for el in <input[name='modal-size']/>
            set el.checked to false
          end
          for el in <input[name='modal-archived']/>
            set el.checked to false
          end
          set #active-category.value to ''
          set #active-color.value to ''
          set #active-size.value to ''
          set #active-archived.value to ''
          call #filter-modal.close()
          call #search-form.submit()">
        {{t 'lang.CLEAR_FILTERS'}}
      </button>
      <button type="button"
        class="btn btn-primary btn-sm"
        _="on click
          set category to ''
          get the first <input[name='modal-category']:checked/>
          if it then set category to it.value end
          set color to ''
          get the first <input[name='modal-color']:checked/>
          if it then set color to it.value end
          set size to ''
          get the first <input[name='modal-size']:checked/>
          if it then set size to it.value end
          set archived to ''
          get the first <input[name='modal-archived']:checked/>
          if it then set archived to 'true' end
          set #active-category.value to category
          set #active-color.value to color
          set #active-size.value to size
          set #active-archived.value to archived
          call #filter-modal.close()
          call #search-form.submit()">
        {{t 'lang.APPLY_FILTERS'}}
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

{{>dock}}
