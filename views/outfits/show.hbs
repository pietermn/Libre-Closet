{{>navbar}}

<main class="mx-auto max-w-xl px-4 pb-28 pt-20">
  <header class="mb-5 flex items-center gap-2">
    <a
      href="/outfits"
      class="btn btn-ghost btn-circle btn-sm"
      aria-label="{{t 'lang.OUTFITS'}}"
      onclick="
        if (window.history.length > 1) {
          window.history.back();
          return false;
        }
      "
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="size-4"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
        />
      </svg>
    </a>
    <div class="min-w-0 flex-1">
      <p
        class="text-xs font-medium tracking-wider text-base-content/50 uppercase"
      >
        {{t 'lang.OUTFITS'}}
      </p>
      <h1 class="truncate text-2xl font-bold tracking-tight">
        {{outfit.name}}
      </h1>
    </div>
    <div
      class="tooltip tooltip-bottom shrink-0"
      data-tip="{{t 'lang.EDIT_OUTFIT'}}"
    >
      <a
        href="/outfits/{{outfit.id}}/edit?returnTo=/outfits/{{outfit.id}}"
        class="btn btn-ghost btn-square btn-sm"
        aria-label="{{t 'lang.EDIT_OUTFIT'}}"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          class="size-5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z"
          />
        </svg>
      </a>
    </div>
    <div class="tooltip tooltip-bottom shrink-0" data-tip="{{t 'lang.SHARE'}}">
      <button
        type="button"
        class="btn btn-ghost btn-circle btn-sm"
        aria-label="{{t 'lang.SHARE'}}"
        onclick="navigator.clipboard.writeText('{{siteUrl}}/share?shareableId={{outfit.shareableId}}&type=outfit'); document.querySelector('#share-toast').classList.remove('hidden'); setTimeout(function () { document.querySelector('#share-toast').classList.add('hidden'); }, 3000)"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          class="size-5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.935-2.185 2.25 2.25 0 0 0-3.935 2.185Z"
          />
        </svg>
      </button>
    </div>
    <details class="dropdown dropdown-end shrink-0">
      <summary
        class="btn btn-ghost btn-square btn-sm list-none"
        aria-label="Outfit options"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 24 24"
          class="size-5"
          aria-hidden="true"
        >
          <path
            d="M12 7.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm0 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm0 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"
          />
        </svg>
      </summary>
      <ul
        class="menu dropdown-content z-30 mt-2 w-52 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"
      >
        <li>
          <button
            class="text-error"
            hx-delete="/outfits/{{outfit.id}}"
            hx-confirm="{{t 'lang.CONFIRM_DELETE'}}"
          >
            {{t 'lang.DELETE'}}
          </button>
        </li>
      </ul>
    </details>
  </header>

  {{#if outfit.pieceCount}}
  <figure
    class="mb-5 aspect-square w-full overflow-hidden rounded-box border border-base-300 bg-base-200 p-3 shadow-sm"
  >
    <div class="grid h-full grid-cols-2 gap-2">
      {{#each outfit.garments}}
      <a
        href="/wardrobe/{{this.id}}"
        hx-boost="false"
        class="group flex min-w-0 flex-col justify-between rounded-field bg-base-100/30 p-2 transition-[transform,background-color] duration-150 ease-out hover:-translate-y-0.5 hover:bg-base-100/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none"
      >
        <div class="flex min-h-0 flex-1 items-center justify-center">
          {{#if this.photo}}
          <img
            src="/file/nobg/{{this.photo.fileName}}"
            alt="{{this.name}}"
            class="h-full w-full object-contain transition-transform duration-200 ease-out group-hover:scale-[1.03] motion-reduce:transition-none"
          />
          {{else}}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.4"
            stroke="currentColor"
            class="size-9 text-base-content/30"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15"
            />
          </svg>
          {{/if}}
        </div>
        <figcaption
          class="mt-2 truncate text-center text-xs font-semibold text-base-content/75"
        >
          {{this.name}}
        </figcaption>
      </a>
      {{/each}}
    </div>
  </figure>
  {{else}}
  <div class="card card-border mb-5 aspect-square w-full bg-base-200">
    <div class="card-body flex items-center justify-center px-6 text-center">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.3"
        stroke="currentColor"
        class="mb-3 size-12 text-base-content/30"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12"
        />
      </svg>
      <p class="text-sm text-base-content/55">No garments added yet.</p>
      <a
        href="/outfits/{{outfit.id}}/edit?returnTo=/outfits/{{outfit.id}}"
        class="btn btn-sm btn-outline mt-2"
        >{{t 'lang.EDIT_OUTFIT'}}</a
      >
    </div>
  </div>
  {{/if}}

  <details
    class="collapse collapse-arrow mb-5 border border-base-300 bg-base-100"
  >
    <summary class="collapse-title min-h-0 py-4 text-sm font-semibold">
      {{t 'lang.ADD_TO_CALENDAR'}}
    </summary>
    <div class="collapse-content">
      <form
        hx-post="/calendar"
        hx-swap="none"
        hx-push-url="false"
        _="on htmx:afterRequest[detail.successful]
        reset me
        remove @open from closest <details/>
        remove .hidden from #calendar-toast
        wait 3s
        add .hidden to #calendar-toast"
        class="flex flex-col gap-3 pt-1"
      >
        <input type="hidden" name="outfitId" value="{{outfit.id}}" />
        <input
          type="date"
          name="date"
          value="{{today}}"
          class="input input-sm w-full"
          required
        />
        <button type="submit" class="btn btn-primary btn-sm w-full">
          {{t 'lang.SAVE'}}
        </button>
      </form>
    </div>
  </details>

  <section class="card card-border bg-base-100">
    <div class="card-body gap-4 p-5">
      <div class="flex items-center justify-between gap-3">
        <h2 class="card-title text-base">Outfit details</h2>
        <span class="badge badge-soft">{{outfit.pieceCount}} pieces</span>
      </div>
      {{#if outfit.notes}}
      <div class="rounded-box bg-base-200 p-3">
        <p
          class="text-xs font-semibold tracking-wider text-base-content/55 uppercase"
        >
          {{t 'lang.NOTES'}}
        </p>
        <p class="mt-1 break-words text-sm leading-6">{{outfit.notes}}</p>
      </div>
      {{else}}
      <p class="text-sm text-base-content/55">
        Add notes for the occasion, weather, or styling details.
      </p>
      {{/if}}
    </div>
  </section>
</main>

<div
  id="calendar-toast"
  class="toast toast-top toast-center top-20 z-20 hidden"
  aria-live="polite"
>
  <div class="alert alert-success shadow-md">
    <span>{{t 'lang.CALENDAR_OUTFIT_ADDED'}}</span>
  </div>
</div>
<div
  id="share-toast"
  class="toast toast-top toast-center top-20 z-20 hidden"
  aria-live="polite"
>
  <div class="alert alert-success shadow-md">
    <span>{{t 'lang.COPIED'}}</span>
  </div>
</div>

<script>
  document.addEventListener('pointerdown', function (event) {
    document
      .querySelectorAll('details.dropdown[open]')
      .forEach(function (menu) {
        if (!menu.contains(event.target)) menu.removeAttribute('open');
      });
  });
</script>

{{>dock}}
