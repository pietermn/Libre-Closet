{{>navbar}}

<main class="mx-auto max-w-xl px-4 pb-28 pt-4">
  <header class="mb-5 flex items-center gap-2">
    <a
      href="{{returnTo}}"
      class="btn btn-ghost btn-circle btn-sm"
      aria-label="{{t 'lang.OUTFITS'}}"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="size-4"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
        />
      </svg>
    </a>
    <div class="min-w-0">
      <p
        class="text-xs font-medium tracking-wider text-base-content/50 uppercase"
      >
        {{t 'lang.OUTFITS'}}
      </p>
      <h1 class="text-2xl font-bold tracking-tight">
        {{#if outfit}}{{t 'lang.EDIT_OUTFIT'}}{{else}}{{t
        'lang.BUILD_OUTFIT_TITLE'}}{{/if}}
      </h1>
    </div>
  </header>

  {{#if categoryRows.length}}
  <form
    method="POST"
    action="{{#if outfit}}/outfits/{{outfit.id}}{{else}}/outfits{{/if}}"
    class="flex flex-col gap-5"
  >
    <input type="hidden" name="returnTo" value="{{returnTo}}" />
    {{#if returnToWeek}}<input
      type="hidden"
      name="returnToWeek"
      value="{{returnToWeek}}"
    />{{/if}}

    <section class="card card-border bg-base-100">
      <div class="card-body gap-4 p-4 sm:p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="card-title text-base">Choose garments</h2>
            <p class="mt-1 text-sm leading-5 text-base-content/60">
              Tap a garment to browse that category. Drag a row to change the
              look’s order.
            </p>
          </div>
        </div>

        <div
          id="outfit-rows-list"
          class="divide-y divide-base-content/8"
          _="init js(me) Sortable.create(me, { handle: '.drag-handle', animation: 150, ghostClass: 'opacity-40' }) end"
        >
          {{#each categoryRows}}{{> outfit_row row=this}}{{/each}}
        </div>

        <div class="rounded-box bg-base-200 p-3">
          <p
            class="mb-2 text-xs font-semibold tracking-wider text-base-content/55 uppercase"
          >
            Add a category
          </p>
          <div class="flex gap-2">
            <select
              id="add-row-input"
              class="input input-sm min-w-0 flex-1"
              aria-label="{{t 'lang.TYPE_OR_SELECT_CATEGORY'}}"
            >
              <option value="" selected disabled>{{t 'lang.TYPE_OR_SELECT_CATEGORY'}}</option>
              {{#each allCategoryRows}}
              <option value="{{this.value}}">{{this.label}}</option>
              {{/each}}
            </select>
            <button
              type="button"
              class="btn btn-outline btn-sm shrink-0"
              _="on click
              set cat to the value of #add-row-input
              if cat is not ''
                js(cat) htmx.ajax('GET', '/outfits/row-fragment?category=' + encodeURIComponent(cat), {target: '#outfit-rows-list', swap: 'beforeend'}) end
                set the value of #add-row-input to ''
              end"
            >
              {{t 'lang.ADD_ROW'}}
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="card card-border bg-base-100">
      <div class="card-body gap-4 p-4 sm:p-5">
        <h2 class="card-title text-base">Outfit details</h2>
        <fieldset class="fieldset gap-2">
          <legend class="fieldset-legend">{{t 'lang.NAME'}}</legend>
          <input
            type="text"
            name="name"
            class="input w-full"
            value="{{#if outfit}}{{outfit.name}}{{/if}}"
            placeholder="e.g. Summer Date Night"
          />
        </fieldset>
        <fieldset class="fieldset gap-2">
          <legend class="fieldset-legend">{{t 'lang.NOTES'}}</legend>
          <textarea
            name="notes"
            class="textarea min-h-24 w-full"
            placeholder="Occasion, weather, or styling details…"
          >
{{#if outfit}}{{outfit.notes}}{{/if}}</textarea
          >
        </fieldset>
      </div>
    </section>

    {{#unless outfit}}
    <details class="collapse collapse-arrow border border-base-300 bg-base-100">
      <summary class="collapse-title min-h-0 py-4 text-sm font-semibold">
        {{t 'lang.ADD_TO_CALENDAR'}}
      </summary>
      <div class="collapse-content">
        <fieldset class="fieldset gap-2 pt-1">
          <legend class="fieldset-legend">Date</legend>
          <input
            type="date"
            name="scheduleDate"
            value="{{#if scheduleDate}}{{scheduleDate}}{{/if}}"
            class="input input-sm w-full"
          />
          <p class="label">
            Optional — this outfit will be added to your calendar when saved.
          </p>
        </fieldset>
      </div>
    </details>
    {{/unless}}

    <div class="flex items-center gap-2">
      <button type="submit" class="btn btn-primary flex-1">
        {{t 'lang.SAVE'}}
      </button>
      {{#unless outfit}}<a href="/outfits/new" class="btn btn-ghost"
        >{{t 'lang.START_OVER'}}</a
      >{{/unless}}
      <a href="{{returnTo}}" class="btn btn-ghost">{{t 'lang.CANCEL'}}</a>
    </div>
  </form>

  {{else}}
  <div class="card card-dash bg-base-200/35">
    <div class="card-body items-center py-16 text-center text-base-content/50">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.2"
        stroke="currentColor"
        class="size-16"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15"
        />
      </svg>
      <p class="max-w-sm text-sm">{{t 'lang.NO_GARMENTS_FOR_BUILDER'}}</p>
      <a href="/wardrobe/new" class="btn btn-primary btn-sm"
        >{{t 'lang.NEW_GARMENT'}}</a
      >
    </div>
  </div>
  {{/if}}
</main>

{{>garmentModal}}
<dialog id="outfit-garment-picker" class="modal">
  <div class="modal-box w-full max-w-lg p-0">
    <div id="outfit-garment-picker-body"></div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>Close</button></form>
</dialog>
<script>
  window.openOutfitGarmentPicker = async function (button) {
    const row = button.closest('.outfit-row');
    const category = row.dataset.category;
    const selectedId = row.querySelector('input[name="garmentId"]').value;
    const response = await fetch(
      '/outfits/picker-fragment?category=' +
        encodeURIComponent(category) +
        '&selectedId=' +
        encodeURIComponent(selectedId),
    );
    if (!response.ok) return;
    document.getElementById('outfit-garment-picker-body').innerHTML =
      await response.text();
    window.activeOutfitRow = row;
    document.getElementById('outfit-garment-picker').showModal();
    document.getElementById('outfit-garment-search').focus();
  };
  window.filterOutfitGarmentPicker = function (input) {
    const query = input.value.trim().toLocaleLowerCase();
    document.querySelectorAll('[data-picker-item]').forEach(function (item) {
      const text = (item.dataset.search || '').toLocaleLowerCase();
      let cursor = 0;
      for (const character of query) {
        cursor = text.indexOf(character, cursor);
        if (cursor === -1) break;
        cursor += 1;
      }
      item.classList.toggle('hidden', cursor === -1);
    });
  };
  window.selectOutfitGarment = async function (category, garmentId) {
    const response = await fetch(
      '/outfits/row-fragment?category=' +
        encodeURIComponent(category) +
        '&garmentId=' +
        encodeURIComponent(garmentId),
    );
    if (!response.ok || !window.activeOutfitRow) return;
    window.activeOutfitRow.outerHTML = await response.text();
    document.getElementById('outfit-garment-picker').close();
    window.activeOutfitRow = null;
  };
</script>
{{>dock}}
